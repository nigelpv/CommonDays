# Supabase Postgres connection string. Keep this server-side and never prefix it with VITE_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Optional direct or session-pooler URL used only by Drizzle migrations.
# DATABASE_MIGRATION_URL=postgresql://postgres:URL_ENCODED_PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require

# Comma-separated exact frontend origins. Production should use its HTTPS URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only enable this explicitly for local development without DATABASE_URL.
# USE_DEVELOPMENT_SEED=true

# Server-only Supabase credentials used for private calendar source uploads.
# Keep SUPABASE_SECRET_KEY out of browser code and never prefix it with VITE_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Public project key used only to ask Supabase Auth to verify admin access tokens.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=calendar-sources

# Only used when DATABASE_URL is omitted and the in-memory development seed is active.
# ADMIN_USER_ID=00000000-0000-4000-8000-000000000001

PORT=8787
