# Supabase Postgres connection string. Keep this server-side and never prefix it with VITE_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Optional direct or session-pooler URL used only by Drizzle migrations.
# DATABASE_MIGRATION_URL=postgresql://postgres:URL_ENCODED_PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require

# Comma-separated exact frontend origins. Production should use its HTTPS URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server-only Supabase credentials used for private calendar source uploads.
# Keep SUPABASE_SECRET_KEY out of browser code and never prefix it with VITE_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Public project key used only to ask Supabase Auth to verify admin access tokens.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=calendar-sources

# Server-only Gemini key used to extract academic-calendar dates.
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Durable background processing. Use cloud keys in production.
INNGEST_EVENT_KEY=REPLACE_WITH_INNGEST_EVENT_KEY
INNGEST_SIGNING_KEY=REPLACE_WITH_INNGEST_SIGNING_KEY

# Optional private email alert when a newly created school resembles one already
# in the directory. These stay server-only; never add them to a VITE_ variable.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
ALERT_EMAIL_FROM="Common Days <onboarding@resend.dev>"
ALERT_EMAIL_TO=YOUR_RESEND_ACCOUNT_EMAIL

# For local development, comment out the cloud keys above and run the Inngest
# dev server, then enable this URL. Do not enable local mode in production.
# INNGEST_DEV=1

PORT=8787
